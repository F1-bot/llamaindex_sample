# Скопіюйте у .env і за потреби змініть. .env у git НЕ комітиться.

OLLAMA_BASE_URL=http://localhost:11434

# Модель має підтримувати tool calling. Перевірити: ollama show qwen3:8b
# Слабкий GPU → qwen3:4b.
LLM_MODEL=qwen3:8b

# Вікно контексту. LlamaIndex передає це значення в Ollama як num_ctx і
# прямо впливає на VRAM: qwen3:8b при 8192 → ~6.3 ГБ, при повних 40960 → ~11 ГБ.
NUM_CTX=8192

# Таймаут запиту до Ollama, секунд. Дефолт LlamaIndex — 30, для агента замало.
REQUEST_TIMEOUT=300

# Куди агент пише звіти. Усі шляхи від моделі санітизуються до цієї теки.
REPORTS_DIR=reports
